{
  "name": "@ultrst-armada/frnlts",
  "version": "0.2.6",
  "private": false,
  "type": "module",
  "description": "FrnlTS semantic frontend runtime, validation tooling, and CLI for React applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "packages/*/dist/**",
    "packages/*/package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./validate": {
      "types": "./packages/validate/dist/index.d.ts",
      "import": "./packages/validate/dist/index.js",
      "default": "./packages/validate/dist/index.js"
    },
    "./cli": {
      "types": "./packages/cli/dist/index.d.ts",
      "import": "./packages/cli/dist/index.js",
      "default": "./packages/cli/dist/index.js"
    }
  },
  "bin": {
    "frnl": "./packages/cli/dist/bin/frnl.js"
  },
  "scripts": {
    "build": "pnpm -r run build && tsup src/index.ts src/react/index.ts src/runtime/index.ts --format esm --dts --clean --external react --external react-dom",
    "test": "pnpm -r run test && vitest run",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit",
    "validate": "node packages/cli/dist/bin/frnl.js validate",
    "dev": "node packages/cli/dist/bin/frnl.js dev",
    "watch": "node packages/cli/dist/bin/frnl.js watch"
  },
  "dependencies": {
    "@dinilmusick/gutts": "^0.1.2",
    "typescript": "^5.7.3",
    "zod": "^3.25.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinilmusick/FrnlTS.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*"
  ]
}
